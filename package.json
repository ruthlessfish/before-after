{
  "name": "before-after",
  "version": "1.0.0",
  "description": "A simple, lightweight, and responsive before-after image comparison slider built with vanilla JavaScript.",
  "homepage": "https://ruthlessfish.github.io/before-after",
  "bugs": {
    "url": "https://github.com/ruthlessfish/before-after/issues",
    "email": "bubbafoley@gmail.com"
  },
  "files": [
    "dist"
  ],
  "browser": "./dist/before-after.es.js",
  "exports": {
    ".": {
      "import": "./dist/before-after.es.js",
      "require": "./dist/before-after.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --project browser",
    "test:node": "vitest run --project node"
  },
  "keywords": [
    "before-after",
    "image-comparison",
    "image-slider",
    "image-comparison-slider",
    "image-comparison-viewer",
    "image-comparison-tool",
    "image-comparison-plugin",
    "image-comparison-library",
    "image-comparison-component",
    "image-comparison-widget",
    "image-comparison-ui"
  ],
  "author": "Shane Pearson <bubbafoley@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "repository": "github:ruthlessfish/before-after",
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.0",
    "terser": "^5.43.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
